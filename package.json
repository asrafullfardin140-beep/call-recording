{
  "name": "cybro-recorder",
  "productName": "Cybro Recorder",
  "version": "0.1.1",
  "description": "Desktop call recorder for web meetings — microphone + system audio to WAV.",
  "main": "src/main/main.js",
  "author": "Cybro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "typecheck": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/paths.js && node --check src/main/permissions.js && node --check src/renderer/app.js && node --check src/renderer/audio/recorder.js && node --check src/renderer/audio/wav-encoder.js && node --check src/shared/constants.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cybro.recorder",
    "productName": "Cybro Recorder",
    "copyright": "Copyright © Cybro",
    "artifactName": "Cybro-Recorder-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "Cybro-Recorder-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cybro Recorder needs the microphone to capture your side of web calls.",
        "NSAudioCaptureUsageDescription": "Cybro Recorder needs system audio access to capture the other side of web calls.",
        "NSScreenCaptureDescription": "Cybro Recorder may use screen-capture APIs on macOS to obtain system/loopback audio during calls."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cybro Recorder",
      "artifactName": "Cybro-Recorder-${version}-win-x64-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Cybro-Recorder-${version}-win-x64-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
